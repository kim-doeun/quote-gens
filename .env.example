# Copy this file to .env and fill in real values before running
# `docker compose up`. .env is git-ignored so real secrets never get committed.

# Slack Incoming Webhook URL used to notify a channel when a quote is issued.
# Leave empty to disable the notification.
SLACK_WEBHOOK_URL=

# Host port to publish the app on (container always listens on 3000).
APP_PORT=3000
